<%- include('../partials/header') %>

<div class="container mt-4">

    <!-- ENCABEZADO Y BOTONES -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold mb-0">
            <i class="fas fa-chart-line me-2"></i><%= pageTitle %>
        </h2>
        <div class="btn-group">
            <button onclick="window.print()" class="btn btn-outline-dark btn-sm">
                <i class="fas fa-print"></i> Imprimir
            </button>
            <a href="/admin/informes" class="btn btn-secondary btn-sm">Volver</a>
        </div>
    </div>

    <!-- TARJETA DE FILTROS (Compacta y Responsiva) -->
    <div class="card shadow-sm mb-4 bg-light border-0">
        <div class="card-body py-3">
            <!-- Determinamos la ruta de acción según el tipo de reporte -->
            <% 
                let actionRoute = '/admin/reporte-ventas';
                if (typeof tipo !== 'undefined' && tipo === 'ranking') {
                    actionRoute = '/admin/reporte-ranking';
                }
            %>
            
            <form action="<%= actionRoute %>" method="POST" class="row g-2 align-items-end">
                <!-- Fecha Inicio: Ocupa mitad en móvil (col-6), auto en escritorio -->
                <div class="col-6 col-md-auto">
                    <label class="form-label small fw-bold text-muted mb-1">Desde</label>
                    <input type="date" name="fechaInicio" class="form-control form-control-sm" 
                           value="<%= typeof fechaInicio !== 'undefined' ? fechaInicio : '' %>" required>
                </div>

                <!-- Fecha Fin: Ocupa mitad en móvil (col-6), auto en escritorio -->
                <div class="col-6 col-md-auto">
                    <label class="form-label small fw-bold text-muted mb-1">Hasta</label>
                    <input type="date" name="fechaFin" class="form-control form-control-sm" 
                           value="<%= typeof fechaFin !== 'undefined' ? fechaFin : '' %>" required>
                </div>

                <!-- Botón Filtrar: Ocupa todo en móvil, auto en escritorio -->
                <div class="col-12 col-md-auto">
                    <button type="submit" class="btn btn-primary btn-sm w-100">
                        <i class="fas fa-search me-1"></i> Filtrar Resultados
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- RESUMEN DE KPI (TOTALES) -->
    <!-- Solo se muestra si existe la variable resumen y el tipo es ventas -->
    <% if (typeof resumen !== 'undefined' && resumen && tipo === 'ventas') { %>
        <div class="row g-3 mb-4">
            <!-- Ingresos Totales -->
            <div class="col-12 col-sm-6">
                <div class="card border-0 shadow-sm" style="background-color: #d1e7dd; color: #0f5132;">
                    <div class="card-body p-3">
                        <h6 class="card-title text-uppercase small fw-bold mb-1">Ingresos Totales</h6>
                        <h2 class="mb-0 fw-bold">$<%= resumen.totalIngresos.toLocaleString('es-CO') %></h2>
                    </div>
                </div>
            </div>

            <!-- Pedidos Atendidos -->
            <div class="col-12 col-sm-6">
                <div class="card border-0 shadow-sm" style="background-color: #cff4fc; color: #055160;">
                    <div class="card-body p-3">
                        <h6 class="card-title text-uppercase small fw-bold mb-1">Pedidos Atendidos</h6>
                        <h2 class="mb-0 fw-bold"><%= resumen.totalPedidos %></h2>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <% if (typeof resumen !== 'undefined' && resumen && tipo === 'ranking') { %>
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm" style="background-color: #e7f1ff; color: #0c4a8a;">
                    <div class="card-body p-3">
                        <h6 class="card-title text-uppercase small fw-bold mb-1">Productos</h6>
                        <h2 class="mb-0 fw-bold"><%= resumen.totalProductos %></h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm" style="background-color: #e8f7ee; color: #0f5132;">
                    <div class="card-body p-3">
                        <h6 class="card-title text-uppercase small fw-bold mb-1">Unidades</h6>
                        <h2 class="mb-0 fw-bold"><%= resumen.totalUnidades %></h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm" style="background-color: #fff7e6; color: #7a4a00;">
                    <div class="card-body p-3">
                        <h6 class="card-title text-uppercase small fw-bold mb-1">Ingresos</h6>
                        <h2 class="mb-0 fw-bold">$<%= resumen.totalIngresos.toLocaleString('es-CO') %></h2>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm" style="background-color: #f3ecff; color: #4c1d95;">
                    <div class="card-body p-3">
                        <h6 class="card-title text-uppercase small fw-bold mb-1">Top #1</h6>
                        <h6 class="mb-0 fw-bold"><%= resumen.topProducto %></h6>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 fw-bold text-primary">Ranking por Unidades</h6>
                            <small class="text-muted">Top 10</small>
                        </div>
                        <div style="height: 280px;">
                            <canvas id="chartRankingBarras"></canvas>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h6 class="mb-2 fw-bold text-primary">Participación de Top 5</h6>
                        <div style="height: 240px;">
                            <canvas id="chartRankingParticipacion"></canvas>
                        </div>
                        <div class="mt-2 small text-muted" id="ranking-detalle">Haz clic en una barra o segmento para ver detalle.</div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- TABLA DE RESULTADOS -->
    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <% if (tipo === 'ranking') { %>
                                <th style="width: 50px;">#</th>
                                <th>Producto</th>
                                <th class="text-center">Cant. Vendida</th>
                                <th class="text-end">Total Generado</th>
                            <% } else { %> <!-- Por defecto Ventas/Kardex -->
                                <th># Pedido</th>
                                <th>Fecha y Hora</th>
                                <th>Ubicación</th>
                                <th class="text-end">Total</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (typeof datos !== 'undefined' && datos.length > 0) { %>
                            <% datos.forEach((dato, index) => { %>
                                <tr>
                                    <% if (tipo === 'ranking') { %>
                                        <td class="fw-bold text-center"><%= index + 1 %></td>
                                        <td>
                                            <% if(index === 0) { %> 🥇 <% } %>
                                            <% if(index === 1) { %> 🥈 <% } %>
                                            <% if(index === 2) { %> 🥉 <% } %>
                                            <%= dato.nombre %>
                                        </td>
                                        <td class="text-center"><span class="badge bg-secondary rounded-pill"><%= dato.cantidad %></span></td>
                                        <td class="text-end fw-bold text-success">$<%= dato.total.toLocaleString('es-CO') %></td>
                                    
                                    <% } else { %> <!-- Ventas / Kardex -->
                                        <td class="fw-bold text-primary">#<%= dato.id %></td>
                                        <td><%= new Date(dato.fecha).toLocaleString('es-CO') %></td>
                                        <td><span class="badge bg-light text-dark border"><%= dato.mesa %></span></td>
                                        <td class="text-end fw-bold text-success">$<%= dato.total.toLocaleString('es-CO') %></td>
                                    <% } %>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 d-block"></i>
                                    No se encontraron resultados en este rango de fechas.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<% if (tipo === 'ranking') { %>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const rankingDatos = <%- JSON.stringify(datos || []) %>;
    const formatoCOP = (v) => `$${Math.round(v || 0).toLocaleString('es-CO')}`;
    const labelsTop10 = rankingDatos.slice(0, 10).map(x => x.nombre);
    const unidadesTop10 = rankingDatos.slice(0, 10).map(x => x.cantidad);
    const ingresosTop10 = rankingDatos.slice(0, 10).map(x => x.total);
    const top5 = rankingDatos.slice(0, 5);
    const detalleEl = document.getElementById('ranking-detalle');

    const chartBarras = new Chart(document.getElementById('chartRankingBarras'), {
        type: 'bar',
        data: {
            labels: labelsTop10,
            datasets: [{
                label: 'Unidades vendidas',
                data: unidadesTop10,
                backgroundColor: 'rgba(13, 110, 253, 0.65)',
                borderColor: '#0d6efd',
                borderWidth: 1.5,
                borderRadius: 8
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: (ctx) => {
                            const i = ctx.dataIndex;
                            return [
                                `Unidades: ${unidadesTop10[i]}`,
                                `Ingresos: ${formatoCOP(ingresosTop10[i])}`
                            ];
                        }
                    }
                }
            },
            onClick: (evt, els) => {
                if (!els.length) return;
                const idx = els[0].index;
                detalleEl.textContent = `${labelsTop10[idx]}: ${unidadesTop10[idx]} unidades | ${formatoCOP(ingresosTop10[idx])}`;
            },
            scales: {
                y: { beginAtZero: true, ticks: { precision: 0 } }
            }
        }
    });

    const totalTop5 = top5.reduce((a, x) => a + x.cantidad, 0);
    new Chart(document.getElementById('chartRankingParticipacion'), {
        type: 'doughnut',
        data: {
            labels: top5.map(x => x.nombre),
            datasets: [{
                data: top5.map(x => x.cantidad),
                backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6f42c1'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 10 } },
                tooltip: {
                    callbacks: {
                        label: (ctx) => {
                            const val = ctx.raw || 0;
                            const pct = totalTop5 > 0 ? (val * 100 / totalTop5) : 0;
                            return `${ctx.label}: ${val} (${pct.toFixed(1)}%)`;
                        }
                    }
                }
            }
        }
    });
</script>
<% } %>

<%- include('../partials/footer') %>
