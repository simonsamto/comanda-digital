<%- include('../partials/header') %>

<div class="container-fluid px-4 mt-4">
    
    <!-- TÍTULO -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Tablero de Control</h2>
            <p class="text-muted mb-0">Visión general del negocio en tiempo real</p>
        </div>
        <div class="text-end">
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="far fa-calendar-alt me-2"></i> <%= new Date().toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
            </span>
        </div>
    </div>

    <!-- SECCIÓN 1: KPI DE VENTAS (EL PULSO) -->
    <div class="row g-3 mb-4">
        <!-- Venta Hoy -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #0d6efd !important;">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold">Ventas Hoy</h6>
                    <h2 class="fw-bold mb-0 text-primary">$<%= kpis.dia.total.toLocaleString('es-CO') %></h2>
                    <small class="<%= kpis.dia.total >= kpis.ayer.total ? 'text-success' : 'text-danger' %> fw-bold">
                        <i class="fas fa-<%= kpis.dia.total >= kpis.ayer.total ? 'arrow-up' : 'arrow-down' %>"></i> 
                        vs Ayer ($<%= kpis.ayer.total.toLocaleString('es-CO') %>)
                    </small>
                </div>
            </div>
        </div>
        
        <!-- Venta Mes -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #198754 !important;">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold">Ventas Mes Actual</h6>
                    <h2 class="fw-bold mb-0 text-success">$<%= kpis.mes.total.toLocaleString('es-CO') %></h2>
                    <small class="text-muted">Total acumulado</small>
                </div>
            </div>
        </div>

        <!-- Promedio Diario -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #ffc107 !important;">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold">Promedio Diario</h6>
                    <h2 class="fw-bold mb-0 text-dark">$<%= promedioDiario.toLocaleString('es-CO', {maximumFractionDigits: 0}) %></h2>
                    <small class="text-muted">Base mes actual</small>
                </div>
            </div>
        </div>

        <!-- Fiado / Por Cobrar -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100" style="border-left: 5px solid #dc3545 !important;">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-bold">Total Fiado (Pendiente)</h6>
                    <h2 class="fw-bold mb-0 text-danger">$<%= totalFiado.toLocaleString('es-CO') %></h2>
                    <small class="text-muted"><%= clientesFiados %> pedidos pendientes</small>
                </div>
            </div>
        </div>
    </div>

    <!-- SECCIÓN 2: DEUDAS EMPRESAS (INTERACTIVO) -->
    <h5 class="text-primary fw-bold mb-3"><i class="fas fa-building me-2"></i>Deudas por Empresa (Cobranza)</h5>
    <div class="row g-3 mb-5">
        <% if (deudaEmpresas.length > 0) { %>
            <% deudaEmpresas.forEach(emp => { %>
                <div class="col-md-4 col-lg-3">
                    <a href="/admin/informes/cobranza?empresaId=<%= emp.id %>" class="text-decoration-none">
                        <div class="card border-0 shadow-sm h-100 hover-scale">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1"><%= emp.nombre %></h6>
                                    <span class="badge bg-secondary"><%= emp.pedidos %> Pedidos</span>
                                </div>
                                <div class="text-end">
                                    <h5 class="fw-bold text-danger mb-0">$<%= emp.deuda.toLocaleString('es-CO') %></h5>
                                    <small class="text-muted" style="font-size: 0.75rem;">Clic para cobrar <i class="fas fa-arrow-right"></i></small>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12">
                <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i> No hay deudas pendientes de empresas.</div>
            </div>
        <% } %>
    </div>

    <div class="row g-4">
        <!-- COLUMNA IZQUIERDA: GRÁFICOS Y ESTADÍSTICAS -->
        <div class="col-lg-8">
            
            <!-- GRÁFICO HORAS PICO -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-clock me-2 text-primary"></i>Ventas por Hora (Hoy)</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartHoras" height="100"></canvas>
                </div>
            </div>

            <!-- TOP PLATOS (TABLA) -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-trophy me-2 text-warning"></i>Top 10 Platos Más Vendidos</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">#</th>
                                    <th>Plato</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end pe-4">Ingresos Generados</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topPlatosList.forEach((plato, index) => { %>
                                    <tr>
                                        <td class="ps-4 fw-bold text-muted"><%= index + 1 %></td>
                                        <td>
                                            <span class="fw-bold"><%= plato.nombre %></span>
                                            <!-- Barra de progreso visual -->
                                            <div class="progress mt-1" style="height: 4px; width: 100px;">
                                                <div class="progress-bar bg-primary" role="progressbar" style="width: <%= (plato.cant / topPlatosList[0].cant) * 100 %>%"></div>
                                            </div>
                                        </td>
                                        <td class="text-center"><span class="badge bg-light text-dark border"><%= plato.cant %></span></td>
                                        <td class="text-end pe-4 fw-bold text-success">$<%= plato.dinero.toLocaleString('es-CO') %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <!-- COLUMNA DERECHA: RESÚMENES -->
        <div class="col-lg-4">

            <!-- RANKING MESAS -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-chair me-2 text-info"></i>Ventas por Mesa/Punto</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartMesas" height="200"></canvas>
                </div>
            </div>

            <!-- INGREDIENTES / CONSUMO -->
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-header border-0 py-3 bg-primary">
                    <h6 class="mb-0 fw-bold text-white"><i class="fas fa-carrot me-2"></i>Top Consumo (Acompañantes)</h6>
                </div>
                <div class="card-body pt-0">
                    <ul class="list-group list-group-flush rounded">
                        <% topComponentes.forEach(comp => { %>
                            <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent text-white border-bottom border-white-50 px-0">
                                <span><%= comp.nombre %></span>
                                <span class="badge bg-white text-primary rounded-pill"><%= comp.cantidad %></span>
                            </li>
                        <% }) %>
                    </ul>
                    <small class="mt-3 d-block text-white-50">Estimado basado en pedidos del mes.</small>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- LIBRERÍA CHART.JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    .hover-scale { transition: transform 0.2s; cursor: pointer; }
    .hover-scale:hover { transform: translateY(-5px); }
</style>

<script>
    // 1. GRÁFICO DE HORAS
    const ctxHoras = document.getElementById('chartHoras').getContext('2d');
    new Chart(ctxHoras, {
        type: 'bar',
        data: {
            labels: <%- graficos.horasLabels %>,
            datasets: [{
                label: 'Ventas ($)',
                data: <%- graficos.horasData %>,
                backgroundColor: 'rgba(13, 110, 253, 0.7)',
                borderRadius: 4
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, grid: { display: false } }, x: { grid: { display: false } } }
        }
    });

    // 2. GRÁFICO DE MESAS (Doughnut)
    const ctxMesas = document.getElementById('chartMesas').getContext('2d');
    new Chart(ctxMesas, {
        type: 'doughnut',
        data: {
            labels: <%- graficos.topMesasLabels %>,
            datasets: [{
                data: <%- graficos.topMesasData %>,
                backgroundColor: [
                    '#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796'
                ],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            cutout: '70%',
            plugins: {
                legend: { position: 'bottom', labels: { boxWidth: 10, usePointStyle: true } }
            }
        }
    });
</script>

<%- include('../partials/footer') %>