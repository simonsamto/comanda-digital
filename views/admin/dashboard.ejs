<%- include('../partials/header') %>

<style>
    /* Estilos personalizados para alto impacto visual */
    .card-kpi {
        border: none;
        border-radius: 15px;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
        min-height: 120px;
    }
    .card-kpi:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .bg-gradient-primary-soft { background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); }
    .bg-gradient-success-soft { background: linear-gradient(135deg, #1cc88a 0%, #13855c 100%); }
    .bg-gradient-warning-soft { background: linear-gradient(135deg, #f6c23e 0%, #dda20a 100%); }
    .bg-gradient-danger-soft  { background: linear-gradient(135deg, #e74a3b 0%, #be2617 100%); }
    
    .kpi-icon {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 3.5rem;
        opacity: 0.15;
        color: #fff;
    }
    
    /* Ajustes para mÃ³vil */
    @media (max-width: 768px) {
        .card-kpi { min-height: 100px; }
        .kpi-value { font-size: 1.2rem !important; }
        .kpi-label { font-size: 0.7rem !important; }
        .kpi-icon { font-size: 2.5rem; }
    }
    
    .card-dashboard {
        border: none;
        border-radius: 15px;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.05);
    }
    .card-header-clean {
        background-color: transparent;
        border-bottom: 1px solid rgba(0,0,0,0.05);
        padding: 1.2rem;
    }
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
    .hover-scale { transition: transform 0.2s; cursor: pointer; }
    .hover-scale:hover { transform: translateY(-3px); }
</style>

<div class="container-fluid px-3 px-md-4 mt-4 mb-5">
    
    <!-- HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-2 mb-md-0">
            <h3 class="fw-bold text-dark mb-0"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Centro de Control</h3>
            <small class="text-muted"><%= new Date().toLocaleDateString('es-CO', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></small>
        </div>
        <div>
             <!-- BotÃ³n Caja -->
             <a href="/cajero" class="btn btn-success shadow-sm btn-sm px-4 py-2 rounded-pill">
                <i class="fas fa-cash-register me-2"></i> Ir a Caja (Cobrar)
            </a>
        </div>
    </div>

    <!-- SECCIÃ“N 1: KPIS PRINCIPALES -->
    <div class="row g-2 g-md-3 mb-4">
        <!-- Venta Hoy -->
        <div class="col-6 col-xl-3">
            <div class="card-kpi bg-gradient-primary-soft text-white p-3">
                <div class="kpi-content position-relative z-1">
                    <div class="kpi-label text-uppercase opacity-75 fw-bold mb-1">Ventas Hoy</div>
                    <div class="kpi-value h3 fw-bold mb-0">$<%= kpis.dia.total.toLocaleString('es-CO') %></div>
                    <div class="mt-2 small">
                        <% if(kpis.dia.total >= kpis.ayer.total) { %>
                            <span class="badge bg-white text-primary rounded-pill"><i class="fas fa-arrow-up"></i> Mejor que ayer</span>
                        <% } else { %>
                            <span class="badge bg-white text-danger rounded-pill opacity-75"><i class="fas fa-arrow-down"></i></span>
                        <% } %>
                    </div>
                </div>
                <i class="fas fa-cash-register kpi-icon"></i>
            </div>
        </div>
        
        <!-- Venta Mes -->
        <div class="col-6 col-xl-3">
            <div class="card-kpi bg-gradient-success-soft text-white p-3">
                <div class="kpi-content position-relative z-1">
                    <div class="kpi-label text-uppercase opacity-75 fw-bold mb-1">Ventas Mes</div>
                    <div class="kpi-value h3 fw-bold mb-0">$<%= kpis.mes.total.toLocaleString('es-CO') %></div>
                    <div class="mt-2 small opacity-75">Acumulado</div>
                </div>
                <i class="fas fa-calendar-alt kpi-icon"></i>
            </div>
        </div>

        <!-- Promedio -->
        <div class="col-6 col-xl-3">
            <div class="card-kpi bg-gradient-warning-soft text-white p-3">
                <div class="kpi-content position-relative z-1">
                    <div class="kpi-label text-uppercase opacity-75 fw-bold mb-1">Promedio Diario</div>
                    <div class="kpi-value h3 fw-bold mb-0">$<%= promedioDiario.toLocaleString('es-CO', {maximumFractionDigits: 0}) %></div>
                    <div class="mt-2 small opacity-75">Meta diaria</div>
                </div>
                <i class="fas fa-chart-line kpi-icon"></i>
            </div>
        </div>

        <!-- Fiado -->
        <div class="col-6 col-xl-3">
            <div class="card-kpi bg-gradient-danger-soft text-white p-3">
                <div class="kpi-content position-relative z-1">
                    <div class="kpi-label text-uppercase opacity-75 fw-bold mb-1">Por Cobrar</div>
                    <div class="kpi-value h3 fw-bold mb-0">$<%= totalFiado.toLocaleString('es-CO') %></div>
                    <div class="mt-2 small">
                        <span class="badge bg-white text-danger rounded-pill"><%= clientesFiados %> Pedidos</span>
                    </div>
                </div>
                <i class="fas fa-hand-holding-usd kpi-icon"></i>
            </div>
        </div>
    </div>

    <!-- SECCIÃ“N NUEVA: ACCESOS RÃPIDOS (GestiÃ³n) -->
    <h6 class="text-uppercase text-secondary fw-bold mb-3 small ps-1">GestiÃ³n RÃ¡pida</h6>
    <div class="row g-3 mb-4">
        
        <!-- Mesas (AGREGADO) -->
        <div class="col-6 col-md-3">
            <a href="/admin/mesas" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100 hover-scale">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="avatar-circle bg-success text-white me-3"><i class="fas fa-chair"></i></div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Mesas</h6>
                            <small class="text-muted d-none d-md-block">Mapa y Zonas</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- MenÃºs -->
        <div class="col-6 col-md-3">
            <a href="/admin/menus" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100 hover-scale">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="avatar-circle bg-warning text-white me-3"><i class="fas fa-book-open"></i></div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">MenÃºs</h6>
                            <small class="text-muted d-none d-md-block">Platos y precios</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Usuarios -->
        <div class="col-6 col-md-3">
            <a href="/admin/usuarios" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100 hover-scale">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="avatar-circle bg-secondary text-white me-3"><i class="fas fa-users"></i></div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Usuarios</h6>
                            <small class="text-muted d-none d-md-block">Personal</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Empresas -->
        <div class="col-6 col-md-3">
            <a href="/admin/empresas" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100 hover-scale">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="avatar-circle bg-primary text-white me-3"><i class="fas fa-building"></i></div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Empresas</h6>
                            <small class="text-muted d-none d-md-block">Gestionar crÃ©dito</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- Informes -->
        <div class="col-6 col-md-3">
            <a href="/admin/informes" class="text-decoration-none">
                <div class="card shadow-sm border-0 h-100 hover-scale">
                    <div class="card-body d-flex align-items-center p-3">
                        <div class="avatar-circle bg-info text-white me-3"><i class="fas fa-chart-pie"></i></div>
                        <div>
                            <h6 class="mb-0 fw-bold text-dark">Informes</h6>
                            <small class="text-muted d-none d-md-block">Reportes completos</small>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- SECCIÃ“N GRÃFICOS Y TABLAS -->
    <div class="row g-4">
        <!-- COLUMNA IZQUIERDA -->
        <div class="col-lg-8">
            
            <!-- GRÃFICO VENTAS HORA -->
            <div class="card card-dashboard mb-4">
                <div class="card-header-clean d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary">Actividad por Hora (Hoy)</h6>
                    <div class="btn-group btn-group-sm" role="group" aria-label="MÃ©trica por hora">
                        <button type="button" class="btn btn-outline-primary active" id="btn-metrica-ventas">Ventas</button>
                        <button type="button" class="btn btn-outline-primary" id="btn-metrica-pedidos">Pedidos</button>
                        <button type="button" class="btn btn-outline-primary" id="btn-metrica-ticket">Ticket</button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 250px;">
                        <canvas id="chartHoras"></canvas>
                    </div>
                    <div class="mt-3 p-2 rounded bg-light border small">
                        <strong id="hora-detalle-titulo">Selecciona un punto</strong>
                        <div class="text-muted" id="hora-detalle-contenido">Haz clic en la grÃ¡fica para ver ventas, pedidos y ticket promedio de esa hora.</div>
                    </div>
                </div>
            </div>

            <!-- GRÃFICO COMPARATIVO SEMANAL -->
            <div class="card card-dashboard mb-4">
                <div class="card-header-clean d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-primary">Comparativo Semanal</h6>
                    <small class="text-muted">Ventas vs Pedidos</small>
                </div>
                <div class="card-body">
                    <div class="chart-area" style="height: 240px;">
                        <canvas id="chartSemana"></canvas>
                    </div>
                </div>
            </div>

            <!-- TABLA TOP PLATOS -->
            <div class="card card-dashboard">
                <div class="card-header-clean">
                    <h6 class="m-0 fw-bold text-primary">Top Productos del Mes</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 border-0">Producto</th>
                                    <th class="text-center border-0">Cant.</th>
                                    <th class="text-end pe-4 border-0">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% topPlatosList.slice(0, 5).forEach((plato, index) => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle bg-light text-primary me-3 small">
                                                    <%= index + 1 %>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark"><%= plato.nombre %></div>
                                                    <div class="progress mt-1" style="height: 3px; width: 80px;">
                                                        <div class="progress-bar bg-info" role="progressbar" style="width: <%= (plato.cant / topPlatosList[0].cant) * 100 %>%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold text-secondary"><%= plato.cant %></td>
                                        <td class="text-end pe-4 fw-bold text-success">$<%= plato.dinero.toLocaleString('es-CO') %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA -->
        <div class="col-lg-4">

            <!-- TARJETA DEUDAS EMPRESAS -->
            <div class="card card-dashboard mb-4 border-start border-4 border-danger">
                <div class="card-header-clean bg-white d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-danger"><i class="fas fa-exclamation-circle me-2"></i>Cuentas por Cobrar</h6>
                    <small class="text-muted"><%= deudaEmpresas.length %> Empresas</small>
                </div>
                <div class="card-body p-2">
                    <% if (deudaEmpresas.length > 0) { %>
                        <div class="list-group list-group-flush">
                            <% deudaEmpresas.slice(0, 4).forEach(emp => { %>
                                <a href="/admin/informes/cobranza?empresaId=<%= emp.id %>" class="list-group-item list-group-item-action border-0 rounded-3 mb-1 d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark"><%= emp.nombre %></div>
                                        <small class="text-muted"><%= emp.pedidos %> pedidos pendientes</small>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold text-danger">$<%= emp.deuda.toLocaleString('es-CO') %></div>
                                        <small class="text-primary" style="font-size: 0.7rem;">Cobrar <i class="fas fa-chevron-right"></i></small>
                                    </div>
                                </a>
                            <% }) %>
                            <% if (deudaEmpresas.length > 4) { %>
                                <div class="text-center mt-2">
                                    <a href="/admin/informes/cobranza" class="btn btn-sm btn-outline-danger rounded-pill">Ver todas</a>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-check-circle fa-2x text-success mb-2"></i>
                            <p class="mb-0 small">Â¡Todo al dÃ­a! No hay deudas.</p>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- CHART MESAS -->
            <div class="card card-dashboard">
                <div class="card-header-clean">
                    <h6 class="m-0 fw-bold text-dark">Ventas por Zona</h6>
                </div>
                <div class="card-body">
                    <div style="height: 200px; position: relative;">
                        <canvas id="chartMesas"></canvas>
                    </div>
                    <div class="mt-3 p-2 rounded bg-light border small">
                        <strong id="mesa-detalle-titulo">Top mesa por ventas</strong>
                        <div class="text-muted" id="mesa-detalle-contenido">Haz clic en una zona del grÃ¡fico para ver participaciÃ³n, pedidos y ticket promedio.</div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Scripts Gráficos -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    Chart.defaults.font.family = "'Segoe UI', 'Helvetica', 'Arial', sans-serif";

    const formatoCOP = (value) => `$${Math.round(value || 0).toLocaleString('es-CO')}`;
    const datosHoras = {
        labels: <%- graficos.horasLabels %>,
        ventas: <%- graficos.horasData %>,
        pedidos: <%- graficos.horasPedidosData %>,
        ticket: <%- graficos.horasTicketPromedioData %>
    };
    const datosSemana = {
        labels: <%- graficos.semanaLabels %>,
        ventas: <%- graficos.semanaVentasData %>,
        pedidos: <%- graficos.semanaPedidosData %>
    };
    const mesasDetalle = <%- graficos.topMesasDetalle %>;

    const estadoMetricas = {
        ventas: { label: 'Ventas', color: '#4e73df', data: datosHoras.ventas },
        pedidos: { label: 'Pedidos', color: '#1cc88a', data: datosHoras.pedidos },
        ticket: { label: 'Ticket Promedio', color: '#f6c23e', data: datosHoras.ticket }
    };

    let metricaActiva = 'ventas';
    const btnVentas = document.getElementById('btn-metrica-ventas');
    const btnPedidos = document.getElementById('btn-metrica-pedidos');
    const btnTicket = document.getElementById('btn-metrica-ticket');
    const btnMetricas = { ventas: btnVentas, pedidos: btnPedidos, ticket: btnTicket };
    const horaDetalleTitulo = document.getElementById('hora-detalle-titulo');
    const horaDetalleContenido = document.getElementById('hora-detalle-contenido');
    const mesaDetalleTitulo = document.getElementById('mesa-detalle-titulo');
    const mesaDetalleContenido = document.getElementById('mesa-detalle-contenido');

    const ctxHoras = document.getElementById('chartHoras');
    const chartHoras = new Chart(ctxHoras, {
        type: 'line',
        data: {
            labels: datosHoras.labels,
            datasets: [{
                label: estadoMetricas[metricaActiva].label,
                data: estadoMetricas[metricaActiva].data,
                borderColor: estadoMetricas[metricaActiva].color,
                backgroundColor: 'rgba(78, 115, 223, 0.08)',
                borderWidth: 2,
                pointRadius: 2,
                pointHoverRadius: 5,
                fill: true,
                tension: 0.35
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: (ctx) => {
                            const idx = ctx.dataIndex;
                            return [
                                `Ventas: ${formatoCOP(datosHoras.ventas[idx])}`,
                                `Pedidos: ${datosHoras.pedidos[idx]}`,
                                `Ticket promedio: ${formatoCOP(datosHoras.ticket[idx])}`
                            ];
                        }
                    }
                }
            },
            onClick: (evt, elements) => {
                if (!elements.length) return;
                const idx = elements[0].index;
                horaDetalleTitulo.textContent = `Detalle ${datosHoras.labels[idx]}`;
                horaDetalleContenido.textContent = `Ventas ${formatoCOP(datosHoras.ventas[idx])} | Pedidos ${datosHoras.pedidos[idx]} | Ticket promedio ${formatoCOP(datosHoras.ticket[idx])}`;
            },
            scales: {
                x: { grid: { display: false }, ticks: { maxTicksLimit: 8, font: { size: 10 } } },
                y: {
                    grid: { borderDash: [2, 2] },
                    ticks: { callback: (value) => metricaActiva === 'pedidos' ? value : formatoCOP(value) }
                }
            }
        }
    });

    const activarMetrica = (key) => {
        metricaActiva = key;
        Object.keys(btnMetricas).forEach(k => btnMetricas[k].classList.toggle('active', k === key));
        chartHoras.data.datasets[0].label = estadoMetricas[key].label;
        chartHoras.data.datasets[0].data = estadoMetricas[key].data;
        chartHoras.data.datasets[0].borderColor = estadoMetricas[key].color;
        chartHoras.update();
    };
    btnVentas.addEventListener('click', () => activarMetrica('ventas'));
    btnPedidos.addEventListener('click', () => activarMetrica('pedidos'));
    btnTicket.addEventListener('click', () => activarMetrica('ticket'));

    const ctxSemana = document.getElementById('chartSemana');
    new Chart(ctxSemana, {
        type: 'bar',
        data: {
            labels: datosSemana.labels,
            datasets: [
                {
                    type: 'bar',
                    label: 'Ventas',
                    data: datosSemana.ventas,
                    backgroundColor: 'rgba(54, 185, 204, 0.55)',
                    borderColor: '#36b9cc',
                    borderWidth: 1.2,
                    yAxisID: 'y'
                },
                {
                    type: 'line',
                    label: 'Pedidos',
                    data: datosSemana.pedidos,
                    borderColor: '#1cc88a',
                    backgroundColor: '#1cc88a',
                    borderWidth: 2,
                    pointRadius: 3,
                    tension: 0.35,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            maintainAspectRatio: false,
            plugins: {
                tooltip: {
                    callbacks: {
                        label: (ctx) => ctx.dataset.label === 'Ventas' ? `Ventas: ${formatoCOP(ctx.raw)}` : `Pedidos: ${ctx.raw}`
                    }
                }
            },
            scales: {
                y: {
                    position: 'left',
                    ticks: { callback: (value) => formatoCOP(value) },
                    grid: { borderDash: [2, 2] }
                },
                y1: {
                    position: 'right',
                    grid: { drawOnChartArea: false },
                    ticks: { stepSize: 1 }
                }
            }
        }
    });

    const ctxMesas = document.getElementById('chartMesas');
    const topMesasData = <%- graficos.topMesasData %>;
    const totalMesas = topMesasData.reduce((acc, val) => acc + val, 0);
    new Chart(ctxMesas, {
        type: 'doughnut',
        data: {
            labels: <%- graficos.topMesasLabels %>,
            datasets: [{
                data: topMesasData,
                backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b'],
                borderWidth: 0,
                hoverOffset: 6
            }]
        },
        options: {
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { position: 'right', labels: { boxWidth: 10, font: { size: 11 } } },
                tooltip: {
                    callbacks: {
                        label: (ctx) => {
                            const valor = ctx.raw || 0;
                            const porcentaje = totalMesas > 0 ? ((valor / totalMesas) * 100) : 0;
                            return `${ctx.label}: ${formatoCOP(valor)} (${porcentaje.toFixed(1)}%)`;
                        }
                    }
                }
            },
            onClick: (evt, elements) => {
                if (!elements.length) return;
                const idx = elements[0].index;
                const detalle = mesasDetalle[idx];
                if (!detalle) return;
                const porcentaje = totalMesas > 0 ? ((detalle.total / totalMesas) * 100) : 0;
                mesaDetalleTitulo.textContent = `${detalle.nombre}`;
                mesaDetalleContenido.textContent = `Ventas ${formatoCOP(detalle.total)} | Participación ${porcentaje.toFixed(1)}% | Pedidos ${detalle.pedidos} | Ticket promedio ${formatoCOP(detalle.ticketPromedio)}`;
            }
        }
    });
</script>
<%- include('../partials/footer') %>


