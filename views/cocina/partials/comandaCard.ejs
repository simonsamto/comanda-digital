<div class="col-12 col-md-6 col-lg-4 mb-3 comanda-card col-movil-compacto" id="pedido-<%= pedido.id %>" data-fecha="<%= pedido.createdAt %>">
    <div class="card h-100 shadow-sm border-2 
        <%= pedido.estado === 'elaborado' ? 'border-success' : 'border-danger' %>">

        <div class="card-header d-flex justify-content-between align-items-center py-1 px-2
            <%= pedido.estado === 'elaborado' ? 'bg-success text-white' : 'bg-danger text-white' %>">
            <h5 class="mb-0 fw-bold fs-5">Mesa <%= pedido.mesa.numero %></h5>
            <span class="badge bg-white text-dark fw-bold" style="font-size: 0.8rem;">#<%= pedido.id %></span>
        </div>

        <div class="card-body p-2">
            <div class="d-flex justify-content-between text-muted small mb-1">
                <span><i class="far fa-clock"></i> <%= new Date(pedido.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
            </div>
            <hr class="my-1 opacity-50">

            <% pedido.items.forEach(item => { %>
                <div class="mb-2 border-bottom pb-1">
                    <!-- Fila 1: Cliente y Plato Principal -->
                    <div class="d-flex justify-content-between align-items-center bg-light px-1 rounded mb-1">
                        <strong class="text-primary small">C-<%= item.cliente_numero %></strong>
                        <span class="fw-bold text-dark small text-truncate" style="max-width: 70%;"><%= item.menu_nombre || 'Plato' %></span>
                    </div>

                    <% if (item.componentes && item.componentes.length > 0) { %>
                        <% 
                            const grupos = {};
                            item.componentes.forEach(c => {
                                const g = c.grupo ? c.grupo.nombre : 'Otros';
                                if(!grupos[g]) grupos[g] = [];
                                grupos[g].push(c.nombre);
                            });
                        %>
                        
                        <div class="ps-1">
                            <!-- A. LO IMPORTANTE (Proteínas y Principios) -->
                            <% Object.keys(grupos).forEach(g => { 
                                const gLow = g.toLowerCase();
                                if (gLow.includes('prote') || gLow.includes('principio')) { %>
                                    <div class="mb-1 d-flex align-items-center">
                                        <span class="badge bg-warning text-dark me-1" style="font-size:0.7rem"><%= g %></span>
                                        <span class="fs-5 fw-bold text-dark lh-1"><%= grupos[g].join(', ') %></span>
                                    </div>
                                <% } 
                            }); %>

                            <!-- B. LO SECUNDARIO (Bebidas, Sopas, etc.) -->
                            <div class="mt-1 lh-1">
                                <% Object.keys(grupos).forEach(g => { 
                                    const gLow = g.toLowerCase();
                                    if (!gLow.includes('prote') && !gLow.includes('principio')) { %>
                                        <span class="badge bg-white text-secondary border me-1 mb-1 fw-normal" style="font-size:0.75rem">
                                            <%= g %>: <%= grupos[g].join(', ') %>
                                        </span>
                                    <% } 
                                }); %>
                            </div>
                        </div>
                    <% } %>

                    <% if (item.notas) { %>
                        <div class="alert alert-warning py-0 px-1 mt-1 mb-0" style="font-size: 0.8rem; border-left: 3px solid #ffc107;">
                            <strong>OJO:</strong> <%= item.notas %>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>

        <div class="card-footer bg-white p-1 border-top-0">
            <% if (pedido.estado !== 'elaborado') { %>
                <form class="estado-form" action="/cocina/pedido/<%= pedido.id %>/estado" method="POST">
                    <input type="hidden" name="nuevoEstado" value="elaborado">
                    <button type="submit" class="btn btn-warning w-100 fw-bold btn-terminar shadow-sm py-2" style="font-size: 1.1rem;">
                        <i class="fas fa-check"></i> LISTO
                    </button>
                </form>
            <% } else { %>
                <button class="btn btn-success w-100 disabled py-2">
                    <i class="fas fa-bell"></i> Esperando...
                </button>
            <% } %>
        </div>
    </div>
</div>