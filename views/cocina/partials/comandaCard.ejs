<div class="col-md-6 col-lg-4 mb-4 comanda-card" id="pedido-<%= pedido.id %>" data-fecha="<%= pedido.createdAt %>">
    <div class="card h-100 shadow-sm border-2 
        <%= pedido.estado === 'elaborado' ? 'border-success' : 'border-danger' %>">

        <div class="card-header d-flex justify-content-between align-items-center
            <%= pedido.estado === 'elaborado' ? 'bg-success text-white' : 'bg-danger text-white' %>">
            <h4 class="mb-0 fw-bold">Mesa <%= pedido.mesa.numero %></h4>
            <span class="badge bg-light text-dark fw-bold">#<%= pedido.id %></span>
        </div>

        <div class="card-body">
            <h6 class="card-subtitle mb-2 text-muted">
                <i class="far fa-clock"></i> <%= new Date(pedido.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
            </h6>
            <hr class="mt-1 mb-2">

            <% pedido.items.forEach(item => { %>
                <div class="mb-3 border-bottom pb-2">
                    <div class="d-flex justify-content-between align-items-start">
                        <strong class="text-primary" style="font-size: 1.1em;">Cliente <%= item.cliente_numero %></strong>
                    </div>
                    
                    <!-- NOMBRE DEL PLATO -->
                    <div class="fw-bold text-dark fs-5 my-1">
                        🍽️ <%= item.menu_nombre || 'Plato' %>
                    </div>

                    <% if (item.componentes && item.componentes.length > 0) { %>
                        <% 
                            const grupos = {};
                            // Orden sugerido: Sopa, Principio, Proteína...
                            const orden = ['Sopa', 'Principio', 'Proteína', 'Proteina', 'Bebida'];
                            item.componentes.forEach(c => {
                                const g = c.grupo ? c.grupo.nombre : 'Extras';
                                if(!grupos[g]) grupos[g] = [];
                                grupos[g].push(c.nombre);
                            });
                            const claves = Object.keys(grupos).sort((a,b) => {
                                const idxA = orden.indexOf(a); const idxB = orden.indexOf(b);
                                if(idxA === -1 && idxB === -1) return a.localeCompare(b);
                                if(idxA === -1) return 1; if(idxB === -1) return -1;
                                return idxA - idxB;
                            });
                        %>
                        <div class="ms-2 mt-1">
                            <% claves.forEach(g => { %>
                                <div class="d-flex mb-1">
                                    <span class="badge bg-secondary me-2 align-self-start" style="min-width: 80px;"><%= g %></span>
                                    <span class="fw-bold"><%= grupos[g].join(', ') %></span>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="text-muted fst-italic ms-2 small">Sin componentes extra</div>
                    <% } %>

                    <% if (item.notas) { %>
                        <div class="alert alert-warning py-1 px-2 mt-1 mb-0 small">
                            <strong>Nota:</strong> <%= item.notas %>
                        </div>
                    <% } %>
                </div>
            <% }); %>
        </div>

        <div class="card-footer bg-white border-top-0 text-center pb-3">
            <% if (pedido.estado !== 'elaborado') { %>
                <form class="estado-form" action="/cocina/pedido/<%= pedido.id %>/estado" method="POST">
                    <input type="hidden" name="nuevoEstado" value="elaborado">
                    <button type="submit" class="btn btn-warning w-100 fw-bold border-2 border-dark shadow-sm">
                        <i class="fas fa-check"></i> TERMINAR PLATO
                    </button>
                </form>
            <% } else { %>
                <button class="btn btn-success w-100 disabled">
                    <i class="fas fa-bell"></i> Esperando Mesero...
                </button>
            <% } %>
        </div>
    </div>
</div>