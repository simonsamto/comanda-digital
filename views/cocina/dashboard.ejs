<%- include('../partials/header') %>

<style>
    .nuevo-pedido-animacion { animation: flashGreen 2s infinite; border: 2px solid #28a745 !important; }
    @keyframes flashGreen { 0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); } 70% { box-shadow: 0 0 0 20px rgba(40, 167, 69, 0); } 100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); } }
    .alerta-demora { animation: panico 0.5s infinite alternate !important; border: 4px solid red !important; color: white !important; }
    .alerta-demora .card-header, .alerta-demora .card-footer { background-color: transparent !important; color: inherit !important; border-color: white !important; }
    .alerta-demora .badge { background-color: yellow !important; color: black !important; }
    @keyframes panico { 0% { background-color: #ff0000; transform: scale(1); } 50% { background-color: #0000ff; transform: scale(1.02); } 100% { background-color: #ff0000; transform: scale(1); } }
    .reloj-cocina { font-family: monospace; font-weight: bold; font-size: 1.2rem; }
</style>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm">
        <div class="d-flex align-items-center gap-3">
            <h1 class="m-0"><i class="fas fa-fire-alt text-danger"></i> Cocina</h1>
            <span class="badge bg-dark fs-5" id="contador-pedidos">Cargando...</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <div class="reloj-cocina text-primary" id="reloj">00:00:00</div>
            <button class="btn btn-outline-danger btn-sm" id="btn-activar-sonido"><i class="fas fa-volume-mute"></i> Sonido</button>
            <a href="/cocina" class="btn btn-outline-primary btn-sm"><i class="fas fa-sync-alt"></i></a>
        </div>
    </div>

    <div class="row" id="pedidos-container">
        <% if (pedidos.length === 0) { %>
            <div id="no-pedidos-placeholder" class="col-12">
                <div class="alert alert-secondary text-center py-5">
                    <h1 class="display-4"><i class="fas fa-check-circle"></i></h1>
                    <h3>Todo al día</h3>
                </div>
            </div>
        <% } else { %>
            <% pedidos.forEach(pedido => { %>
                <%- include('partials/comandaCard', { pedido: pedido }) %>
            <% }); %>
        <% } %>
    </div>
</div>

<template id="comanda-template">
    <div class="col-md-6 col-lg-4 mb-4 comanda-card">
        <div class="card h-100 shadow-sm border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">Mesa <span class="mesa-numero"></span></h4>
                <span class="badge bg-light text-danger border border-danger">#<span class="pedido-id"></span></span>
            </div>
            <div class="card-body">
                <h6 class="card-subtitle mb-2 text-muted"><i class="far fa-clock"></i> <span class="pedido-hora"></span></h6>
                <hr>
                <div class="items-list"></div>
            </div>
            <div class="card-footer bg-white text-center pb-3">
                <form class="estado-form" method="POST">
                    <input type="hidden" name="nuevoEstado" value="elaborado">
                    <button type="submit" class="btn btn-warning w-100 fw-bold border-2 border-dark shadow">
                        <i class="fas fa-check"></i> TERMINAR PLATO
                    </button>
                </form>
            </div>
        </div>
    </div>
</template>

<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const socket = io();
        const audio = new Audio('/sounds/notification.mp3');
        let sonidoActivado = false;

        setInterval(() => document.getElementById('reloj').innerText = new Date().toLocaleTimeString(), 1000);
        document.getElementById('btn-activar-sonido').addEventListener('click', function() {
            audio.play().then(() => { sonidoActivado = true; this.classList.replace('btn-outline-danger', 'btn-success'); this.disabled=true; }).catch(e=>alert(e));
        });

        // MODO PÁNICO
        setInterval(() => {
            const ahora = new Date();
            document.querySelectorAll('.comanda-card').forEach(card => {
                const fecha = new Date(card.dataset.fecha);
                if ((ahora - fecha) > 60000 && !card.querySelector('.border-success')) {
                    card.querySelector('.card').classList.add('alerta-demora');
                }
            });
        }, 5000);

        socket.on('nuevo_pedido', function (pedido) {
            if (sonidoActivado) { audio.currentTime = 0; audio.play(); }
            const ph = document.getElementById('no-pedidos-placeholder');
            if (ph) ph.style.display = 'none';

            const template = document.getElementById('comanda-template');
            const clone = template.content.cloneNode(true);
            const cardRoot = clone.querySelector('.comanda-card');
            
            cardRoot.id = `pedido-${pedido.id}`;
            cardRoot.dataset.fecha = new Date().toISOString();
            cardRoot.classList.add('nuevo-pedido-animacion');
            
            clone.querySelector('.mesa-numero').textContent = pedido.mesa.numero;
            clone.querySelector('.pedido-id').textContent = pedido.id;
            clone.querySelector('.pedido-hora').textContent = new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            clone.querySelector('.estado-form').action = `/cocina/pedido/${pedido.id}/estado`;

            const lista = clone.querySelector('.items-list');
            pedido.items.forEach(item => {
                const grupos = {};
                const orden = ['Sopa', 'Principio', 'Proteína', 'Proteina', 'Bebida'];
                if(item.componentes) item.componentes.forEach(c => {
                    const g = c.grupo ? c.grupo.nombre : 'Extras';
                    if(!grupos[g]) grupos[g] = [];
                    grupos[g].push(c.nombre);
                });

                let gruposHtml = '';
                Object.keys(grupos).sort((a,b) => (orden.indexOf(a)===-1?99:orden.indexOf(a)) - (orden.indexOf(b)===-1?99:orden.indexOf(b))).forEach(g => {
                    gruposHtml += `<div class="d-flex mb-1"><span class="badge bg-secondary me-2" style="min-width:80px;">${g}</span><span class="fw-bold">${grupos[g].join(', ')}</span></div>`;
                });

                const div = document.createElement('div');
                div.className = 'mb-3 border-bottom pb-2';
                // HTML DEL ITEM EN TIEMPO REAL
                div.innerHTML = `
                    <strong class="text-primary" style="font-size: 1.1em;">Cliente ${item.cliente_numero}</strong>
                    <div class="fw-bold text-dark fs-5 my-1">🍽️ ${item.menu_nombre || 'Plato'}</div>
                    <div class="ms-2 mt-1">${gruposHtml || '<div class="text-muted small">Sin extras</div>'}</div>
                    ${item.notas ? `<div class="alert alert-warning py-1 px-2 mt-1 mb-0 small"><strong>Nota:</strong> ${item.notas}</div>` : ''}
                `;
                lista.appendChild(div);
            });

            document.getElementById('pedidos-container').prepend(clone);
            actualizarContador();
        });

        socket.on('actualizacion_estado', (data) => {
            if (data.nuevoEstado === 'elaborado' || data.nuevoEstado === 'entregado') {
                const card = document.getElementById(`pedido-${data.pedidoId}`);
                if (card) {
                    card.style.transition = 'all 0.5s'; card.style.opacity = '0';
                    setTimeout(() => { card.remove(); actualizarContador(); }, 500);
                }
            }
        });

        function actualizarContador() {
            document.getElementById('contador-pedidos').textContent = `${document.querySelectorAll('.comanda-card').length} Pendientes`;
        }
    });
</script>
<%- include('../partials/footer') %>