<%- include('../partials/header') %>

<style>
    /* 1. ANIMACIÓN NUEVO PEDIDO (Borde Verde) */
    .nuevo-pedido-animacion { 
        animation: flashGreen 2s infinite; 
        border: 3px solid #28a745 !important; 
    }
    @keyframes flashGreen { 
        0% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7); } 
        70% { box-shadow: 0 0 0 10px rgba(40, 167, 69, 0); } 
        100% { box-shadow: 0 0 0 0 rgba(40, 167, 69, 0); } 
    }
    
    /* 2. ESTILO VERDE FLUORESCENTE PARA MODIFICADOS (Tu requerimiento) */
    .bg-fluorescente {
        background-color: #39ff14 !important; /* Verde Neón */
        color: black !important;
        border: 3px solid #000 !important;
        box-shadow: 0 0 15px #39ff14;
        animation: latido 1s infinite alternate;
    }
    .bg-fluorescente .card-header, 
    .bg-fluorescente .card-footer {
        background-color: transparent !important;
        border-color: black !important;
        color: black !important;
    }
    .bg-fluorescente .badge {
        background-color: black !important;
        color: #39ff14 !important;
    }
    @keyframes latido {
        from { transform: scale(1); }
        to { transform: scale(1.02); }
    }

    /* 3. ALERTA DEMORA */
    .alerta-demora { border: 4px solid red !important; }

    .reloj-cocina { font-family: monospace; font-weight: bold; font-size: 1.2rem; }
    
    /* Estilos móviles */
    @media (max-width: 768px) {
        .col-movil-compacto { padding-left: 4px; padding-right: 4px; }
        .comanda-card h4 { font-size: 1rem; }
        .btn-terminar { padding: 12px; font-size: 1.2rem; }
    }
</style>

<div class="container-fluid mt-3">
    <!-- BARRA SUPERIOR -->
    <div class="d-flex justify-content-between align-items-center mb-3 bg-white p-2 rounded shadow-sm">
        <div class="d-flex align-items-center gap-2">
            <h1 class="m-0"><i class="fas fa-fire-alt text-danger"></i> Cocina</h1>
            <span class="badge bg-dark fs-5" id="contador-pedidos">0</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="reloj-cocina text-primary d-none d-md-block" id="reloj">00:00</div>
            <button class="btn btn-outline-danger btn-sm" id="btn-activar-sonido"><i class="fas fa-volume-mute"></i></button>
            <a href="/cocina" class="btn btn-outline-secondary btn-sm"><i class="fas fa-sync-alt"></i></a>
        </div>
    </div>

    <!-- CONTENEDOR DE PEDIDOS -->
    <div class="row g-2" id="pedidos-container">
        <% if (pedidos.length === 0) { %>
            <div id="no-pedidos-placeholder" class="col-12">
                <div class="alert alert-secondary text-center py-5">
                    <h1><i class="fas fa-check-circle"></i></h1><p>Todo listo por ahora</p>
                </div>
            </div>
        <% } else { %>
            <% pedidos.forEach(pedido => { %>
                <%- include('partials/comandaCard', { pedido: pedido }) %>
            <% }); %>
        <% } %>
    </div>
</div>

<!-- TEMPLATE PARA GENERAR PEDIDOS CON JS -->
<template id="comanda-template">
    <div class="col-12 col-md-6 col-lg-4 mb-3 comanda-card col-movil-compacto">
        <div class="card h-100 shadow-sm border-danger">
            <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold">Mesa <span class="mesa-numero"></span> <span class="etiqueta-modificado"></span></h4>
                <span class="badge bg-white text-danger fw-bold">#<span class="pedido-id"></span></span>
            </div>
            <div class="card-body p-2">
                <div class="text-muted small mb-1"><i class="far fa-clock"></i> <span class="pedido-hora"></span></div>
                <hr class="my-1">
                <div class="items-list"></div>
            </div>
            <div class="card-footer bg-white p-1">
                <form class="estado-form" method="POST">
                    <input type="hidden" name="nuevoEstado" value="elaborado">
                    <button type="submit" class="btn btn-warning w-100 fw-bold btn-terminar shadow-sm py-2">
                        <i class="fas fa-check"></i> LISTO
                    </button>
                </form>
            </div>
        </div>
    </div>
</template>

<script src="/socket.io/socket.io.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const socket = io();
        const audio = new Audio('/sounds/notification.mp3');
        let sonidoActivado = false;

        // Reloj
        setInterval(() => { 
            const d = new Date(); 
            const el = document.getElementById('reloj');
            if(el) el.innerText = d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
        }, 1000);

        // Activar Sonido
        document.getElementById('btn-activar-sonido').addEventListener('click', function() { 
            audio.play().then(() => { 
                sonidoActivado = true; 
                this.className = 'btn btn-success btn-sm'; 
                this.innerHTML = '<i class="fas fa-volume-up"></i>'; 
                this.disabled = true; 
            }).catch(e => alert("Toca la pantalla primero para activar audio")); 
        });

        // Modo Pánico (Demora)
        setInterval(() => {
            const ahora = new Date();
            document.querySelectorAll('.comanda-card').forEach(card => {
                // Solo si no es modificado (para no quitar el verde)
                if (!card.querySelector('.card').classList.contains('bg-fluorescente')) {
                    if ((ahora - new Date(card.dataset.fecha)) > 60000 && !card.querySelector('.border-success')) {
                        card.querySelector('.card').classList.add('alerta-demora');
                    }
                }
            });
        }, 5000);

        // --- FUNCIÓN CENTRAL PARA DIBUJAR TARJETA ---
        function renderizarTarjeta(pedido, esModificado = false) {
            const ph = document.getElementById('no-pedidos-placeholder'); 
            if (ph) ph.style.display = 'none';

            // Si es modificado, borramos la vieja primero
            if (esModificado) {
                const old = document.getElementById(`pedido-${pedido.id}`);
                if (old) old.remove();
            }

            const template = document.getElementById('comanda-template');
            const clone = template.content.cloneNode(true);
            const cardRoot = clone.querySelector('.comanda-card');
            const cardInner = clone.querySelector('.card');
            
            cardRoot.id = `pedido-${pedido.id}`;
            cardRoot.dataset.fecha = new Date().toISOString();

            // ESTILOS VISUALES
            if (esModificado) {
                cardInner.classList.remove('border-danger');
                cardInner.classList.add('bg-fluorescente'); // CLASE VERDE FOSFORESCENTE
                clone.querySelector('.etiqueta-modificado').innerHTML = '<span class="badge bg-black text-warning blink">MODIFICADO</span>';
            } else {
                cardRoot.classList.add('nuevo-pedido-animacion');
            }
            
            clone.querySelector('.mesa-numero').textContent = pedido.mesa.numero;
            clone.querySelector('.pedido-id').textContent = pedido.id;
            clone.querySelector('.pedido-hora').textContent = new Date().toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'});
            clone.querySelector('.estado-form').action = `/cocina/pedido/${pedido.id}/estado`;

            // RENDERIZAR ITEMS (COMPACTO)
            const lista = clone.querySelector('.items-list');
            pedido.items.forEach(item => {
                const grupos = {};
                if(item.componentes) item.componentes.forEach(c => {
                    const g = c.grupo ? c.grupo.nombre : 'Otros';
                    if(!grupos[g]) grupos[g] = [];
                    grupos[g].push(c.nombre);
                });

                let destacados = '', secundarios = '';
                Object.keys(grupos).forEach(gName => {
                    const cont = grupos[gName].join(', ');
                    if(gName.toLowerCase().includes('prote') || gName.toLowerCase().includes('principio')) {
                        destacados += `<div class="mb-1"><span class="badge bg-warning text-dark me-1">${gName}</span><span class="fw-bold text-dark fs-5">${cont}</span></div>`;
                    } else {
                        secundarios += `<span class="badge bg-light text-secondary border me-1">${gName}: ${cont}</span>`;
                    }
                });

                const div = document.createElement('div');
                div.className = 'mb-2 border-bottom pb-1';
                div.innerHTML = `
                    <div class="d-flex justify-content-between bg-light px-1 rounded">
                        <strong class="text-primary small">C-${item.cliente_numero}</strong>
                        <span class="fw-bold small text-dark">${item.menu_nombre || 'Plato'}</span>
                    </div>
                    <div class="ps-1 mt-1">${destacados}<div class="mt-1 lh-1">${secundarios}</div></div>
                    ${item.notas ? `<div class="alert alert-warning py-0 px-1 mt-1 small"><strong>OJO:</strong> ${item.notas}</div>` : ''}
                `;
                lista.appendChild(div);
            });

            document.getElementById('pedidos-container').prepend(clone);
            actualizarContador();
        }

        function actualizarContador() {
            document.getElementById('contador-pedidos').textContent = document.querySelectorAll('.comanda-card').length;
        }

        // --- LISTENERS DE SOCKET ---
        socket.on('nuevo_pedido', (p) => {
            if (sonidoActivado) audio.play();
            renderizarTarjeta(p, false);
        });

        socket.on('pedido_modificado', (p) => {
            if (sonidoActivado) { audio.play(); setTimeout(()=>audio.play(), 500); } // Doble sonido
            renderizarTarjeta(p, true);
        });

        socket.on('actualizacion_estado', (data) => {
            const card = document.getElementById(`pedido-${data.pedidoId}`);
            if (!card) return;
            if (data.nuevoEstado === 'elaborado') {
                const inner = card.querySelector('.card');
                inner.className = 'card h-100 shadow-sm border-success'; // Quitar estilos fluo
                card.querySelector('.card-header').className = 'card-header bg-success text-white d-flex justify-content-between align-items-center';
                card.querySelector('.card-footer').innerHTML = `<button class="btn btn-success w-100 disabled"><i class="fas fa-bell"></i> Listo</button>`;
            } else if (data.nuevoEstado === 'entregado') {
                card.style.opacity = '0';
                setTimeout(() => { card.remove(); actualizarContador(); }, 500);
            }
        });
        
        actualizarContador();
    });
</script>
<%- include('../partials/footer') %>