<footer class="bg-light text-center text-lg-start mt-auto py-4 border-top">
    <!-- Aseguramos que los íconos se carguen sí o sí -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <div class="container">
        <div class="row align-items-center">
            
            <!-- Columna Izquierda: Copyright -->
            <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                <span class="text-muted small">© <%= new Date().getFullYear() %> Comanda Digital</span>
            </div>

            <!-- Columna Derecha: Piñón -->
            <div class="col-md-6 text-center text-md-end">
                <a href="/admin/billing" 
                   class="d-inline-block p-2 text-dark" 
                   style="opacity: 0.6; transition: all 0.3s ease; text-decoration: none;"
                   onmouseover="this.style.opacity='1'; this.style.transform='rotate(90deg) scale(1.2)'" 
                   onmouseout="this.style.opacity='0.6'; this.style.transform='rotate(0deg) scale(1)'"
                   title="Configuración de Facturación">
                    <i class="fas fa-cog fa-2x"></i> <!-- Aumenté el tamaño a fa-2x -->
                </a>
            </div>
            
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</footer>
</body>
</html>